rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Orders Collection: Real-time table ordering & status tracking
    match /orders/{orderId} {
      allow read: if true;
      allow create: if request.resource.data.tableNumber is number 
                    && request.resource.data.totalAmount is number
                    && request.resource.data.items is list;
      allow update: if request.resource.data.tableNumber is number;
      allow delete: if true;
    }

    // Menu Items Collection: Food catalog management
    match /menu_items/{itemId} {
      allow read: if true;
      allow write: if true;
    }

    // Categories Collection: Food categories
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if true;
    }

    // Coupons Collection: Discount promo codes
    match /coupons/{couponId} {
      allow read: if true;
      allow write: if true;
    }

    // Promotional Banners Collection
    match /banners/{bannerId} {
      allow read: if true;
      allow write: if true;
    }

    match /promo_banners/{bannerId} {
      allow read: if true;
      allow write: if true;
    }

    // System Status & Admin Single-Device Session Lock
    match /system_status/{docId} {
      allow read: if true;
      allow write: if true;
    }

    // Default match for other collections
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
